  "exclusions": [
    {
      "upstream": "dom/events/Event-dispatch-listener-order.window.js",
      "reason": "Requires document.createElement, a closed ShadowRoot, and a five-node propagation path; Ibex's event target deliberately has no DOM tree."
    },
    {
      "upstream": "dom/events/Event-dispatch-order-at-target.html",
      "reason": "The unmodified HTML fixture obtains its target from document.createElement; Ibex has no Document or Element. Equivalent capture-before-bubble behavior at a plain EventTarget is covered by the native suite."
    },
    {
      "upstream": "dom/events/Event-dispatch-throwing.html",
      "reason": "The unmodified HTML fixture creates an Element and observes listener exceptions through Window.onerror; Ibex covers the same non-propagation and global error-reporting behavior on its plain EventTarget."
    },
    {
      "upstream": "dom/events/Event-dispatch-*.html",
      "reason": "All other dispatch fixtures construct or mutate Document/Element trees, exercise activation behavior, or require multiple Window globals; none belongs to the tree-free EventTarget contract."
    },
    {
      "upstream": "dom/abort/*.html",
      "reason": "HTML-only crash and timeout fixtures require Window/document harness behavior; the corresponding engine-independent .any.js algorithms are pinned."
    },
    {
      "upstream": "websockets/**/*.any.js?variant=wss|wpt_flags=h2",
      "reason": "The secure and HTTP/2 variants depend on WPT host/port substitution, its certificate authority, and its Python handlers. Ibex covers local rustls TLS separately; the pinned default fixtures use the local plaintext echo peer."
    },
    {
      "upstream": "websockets/Send-*.any.js (except Send-before-open.any.js)",
      "reason": "The payload fixtures depend on WPT echo and binary-message handlers, including Blob and Float16Array cases outside the installed PURE/EVENTS/WEBSOCKET groups. Ibex's native lifecycle suite covers text, ArrayBuffer and typed-array echo, fragmentation, backpressure, and post-close send."
    },
    {
      "upstream": "websockets/Close-*-verify-code.any.js and Close-server-initiated-close.any.js",
      "reason": "These assert WPT Python close handlers and server-selected close frames. The local transport and JavaScript lifecycle suites cover the client closing handshake, code, reason, clean close, and abnormal close."
    },
    {
      "upstream": "websockets/Create-non-absolute-url.any.js",
      "reason": "It resolves against the WPT Window/Worker location. Ibex has no ambient Document or worker base URL, so relative socket URLs have no host-defined base."
    },
    {
      "upstream": "websockets/opening-handshake/**, closing-handshake/**, handlers/**, binary/**, cookies/**, security/**",
      "reason": "These suites require WPT's HTTP/WebSocket Python handlers, generated domains, cookies, authentication, raw handshake mutation, or policy-bearing Window globals rather than a standalone echo peer."
    },
    {
      "upstream": "websockets/*.html, *.window.js, *.worker.js",
      "reason": "These fixtures require generated HTML/worker wrappers, Window/document lifecycle, sync XHR, back-forward cache, or WPT server substitution; Ibex adopts the engine-independent .any.js subset."
    }
  ]
}
